<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- The Compose theme owns the real colors; this only sets the launch
         window so it matches the brand background instead of flashing white. -->
    <style name="Theme.QuizStudent" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/brand_background</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>
</resources>